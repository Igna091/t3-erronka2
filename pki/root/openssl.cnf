# Guenaga Farmazeutika Root CA (issue #8): the trust anchor of every certificate in both sites.
# Used only by root-ca.sh on the offline root VM. The root signs nothing but intermediate CAs:
# the Infra TLS CA on ca01 (profile "tls"), and the Windows AD CS subordinate (profile "windows").

[ default ]
ca_dir  = ${ENV::ROOT_CA_DIR}
pki_url = http://pki.guenaga.lan

[ ca ]
default_ca = root_ca

[ root_ca ]
dir              = $ca_dir
database         = $dir/index.txt
new_certs_dir    = $dir/newcerts
serial           = $dir/serial
crlnumber        = $dir/crlnumber
certificate      = $dir/certs/root.crt
private_key      = $dir/private/root.key
default_md       = sha256
# An intermediate lives 5 years; the root's CRL, 180 days
default_days     = 1826
default_crl_days = 180
crl_extensions   = crl_ext
unique_subject   = no
# The extensions come from the profile below, never from the request
copy_extensions  = none
policy           = policy_tls
email_in_dn      = no
name_opt         = ca_default
cert_opt         = ca_default

# ca01's request carries the same country and organisation as the root
[ policy_tls ]
countryName      = match
organizationName = match
commonName       = supplied

# AD CS writes its own subject (often DC=guenaga, DC=lan), so only the common name is required
[ policy_windows ]
domainComponent        = optional
countryName            = optional
organizationName       = optional
organizationalUnitName = optional
commonName             = supplied

# The root's own self-signed certificate
[ req ]
default_bits       = 4096
default_md         = sha256
distinguished_name = root_dn
prompt             = no
string_mask        = utf8only

[ root_dn ]
C  = ES
O  = Guenaga Farmazeutika
CN = Guenaga Farmazeutika Root CA

[ v3_root ]
basicConstraints     = critical, CA:true
keyUsage             = critical, keyCertSign, cRLSign
subjectKeyIdentifier = hash

# Intermediate 1: Guenaga Infra TLS CA on ca01. pathlen:0, so it can sign only end certificates,
# and the EKU limits it to server certificates and IPsec gateways (1.3.6.1.5.5.7.3.17 = ipsecIKE)
[ v3_intermediate_tls ]
basicConstraints       = critical, CA:true, pathlen:0
keyUsage               = critical, keyCertSign, cRLSign
extendedKeyUsage       = serverAuth, 1.3.6.1.5.5.7.3.17
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always
crlDistributionPoints  = URI:$pki_url/crl/root.crl
authorityInfoAccess    = caIssuers;URI:$pki_url/ca/root.crt

# Intermediate 2: the Windows AD CS Enterprise Subordinate CA. No EKU limit: it issues domain
# controller, computer, user, Wi-Fi and VPN certificates by auto-enrollment
[ v3_intermediate_windows ]
basicConstraints       = critical, CA:true, pathlen:0
keyUsage               = critical, digitalSignature, keyCertSign, cRLSign
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always
crlDistributionPoints  = URI:$pki_url/crl/root.crl
authorityInfoAccess    = caIssuers;URI:$pki_url/ca/root.crt

[ crl_ext ]
authorityKeyIdentifier = keyid:always
