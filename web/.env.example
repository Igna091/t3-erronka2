# Copy to .env (git ignores it) and change what you need: cp .env.example .env
# compose.yaml reads these; anything left out uses the default shown.

# The site's address. Links in emails are built from it, never from the request.
# web01: https://www.guenaga.eus
APP_URL=https://localhost

# Ports on this machine, if 80, 443 or 8025 are taken (README.md)
#HTTP_PORT=80
#HTTPS_PORT=443
#MAILPIT_PORT=8025

# Who gets the site's emails for real, through the Gmail login in secrets/mailpit_forward.yaml.
# A regular expression in single quotes; unset, nobody does and Mailpit keeps every email.
# Your own machine, where only you reach the site, can take whole providers:
#MAILPIT_DELIVER_TO='(?i)@(gmail\.com|googlemail\.com|hotmail\.(com|es)|outlook\.(com|es)|live\.com|msn\.com|proton\.me|protonmail\.(com|ch)|pm\.me|icloud\.com|yahoo\.(com|es)|([a-z0-9-]+\.)*uni\.eus|([a-z0-9-]+\.)*ehu\.eus)$'
# web01, where anyone can sign up, only the team's own addresses:
#MAILPIT_DELIVER_TO='^(ane@gmail\.com|jon@uni\.eus)$'

# Written by the deploy script on web01 (DEPLOY.md); leave them out on your own machine
#RELEASE=
#PHP_IMAGE=
#MAILER_IMAGE=
